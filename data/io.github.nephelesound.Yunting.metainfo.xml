<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nephelesound.Yunting</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>云听</name>
  <summary>网易云音乐的 Linux 客户端</summary>
  <developer id="io.github.nephelesound">
    <name>Nephele Sound</name>
  </developer>
  <url type="homepage">https://github.com/nephelesound/yunting</url>
  <url type="bugtracker">https://github.com/nephelesound/yunting/issues</url>
  <launchable type="desktop-id">io.github.nephelesound.Yunting.desktop</launchable>
  <provides>
    <binary>yunting</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <description>
    <p>
      为 Linux 打造的网易云音乐客户端：原生 KDE/Qt 界面，个人推荐优先，
      支持 MPRIS 媒体键与系统托盘。
    </p>
  </description>
  <releases>
    <release version="0.5.1" date="2026-10-18">
      <description>
        <p>修复音量过小、插拔耳机后不跟随输出设备、换页时数据错乱与隐私主页报错。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-18">
      <description>
        <p>MV 也改由 mpv 播放，不再需要 Qt Multimedia。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.4.2" date="2026-10-18">
      <description>
        <p>拖动桌面歌词时窗口跟手，悬停底板不再随歌词伸缩。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-18">
      <description>
        <p>桌面歌词的文字阴影不再逐帧重画，并且一律是黑色。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-18">
      <description>
        <p>音乐改由 mpv 播放，插拔耳机时自动跟随系统默认输出。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-18">
      <description>
        <p>中性灰的系统配色下，界面按强调色染上一点色调。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.2.2" date="2026-10-17">
      <description>
        <p>桌面歌词的控制条改成 KDE 标准工具栏，修复透明区域变黑。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-10-17">
      <description>
        <p>修复播放条评论按钮的显示。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-17">
      <description>
        <p>返回时回到离开时的位置，播放条可以直接进评论区。完整的更新日志见仓库里的 CHANGELOG.md。</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-17">
      <description>
        <p>首个公开版本。</p>
      </description>
    </release>
  </releases>
</component>
