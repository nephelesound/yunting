# 云听：从本目录所在仓库的已提交内容构建（无网络源）
pkgname=yunting-git
# 占位版本：makepkg 入口的 lint 要求静态 pkgver，pkgver() 成功后会被就地改写
pkgver=0.1
pkgver() {
  cd "$srcdir/yunting-git"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
pkgrel=1
pkgdesc='网易云音乐的 Linux 客户端（Qt 6 / KDE）'
arch=(x86_64)
license=('GPL-3.0-or-later')
# 系统 makepkg.conf 默认开 debug：会把剥过符号的二进制挪进 -debug 子包，主包变空
options=(!debug)
depends=(qt6-base qt6-declarative qt6-multimedia kirigami kirigami-addons prison qtkeychain-qt6 kstatusnotifieritem)
makedepends=(cmake ninja git)
source=("$pkgname::git+file://$startdir/../..")
sha256sums=(SKIP)

build() {
  cmake -S "$srcdir/yunting-git/src" -B "$srcdir/yunting-git/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/yunting-git/build"
}

check() {
  ctest --test-dir "$srcdir/yunting-git/build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/yunting-git/build"
}
